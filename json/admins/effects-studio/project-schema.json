{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "effects-studio-project.schema.json",
  "title": "Effects Studio Project",
  "type": "object",
  "required": [
    "app",
    "version",
    "width",
    "height",
    "layers"
  ],
  "properties": {
    "app": {
      "const": "Effects Studio"
    },
    "version": {
      "type": "string"
    },
    "projectName": {
      "type": "string"
    },
    "width": {
      "type": "number",
      "minimum": 1
    },
    "height": {
      "type": "number",
      "minimum": 1
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "dataUrl"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "visible": {
            "type": "boolean"
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "blend": {
            "type": "string"
          },
          "dataUrl": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "objects": {
      "type": "array"
    },
    "annotations": {
      "type": "array"
    },
    "frames": {
      "type": "array"
    },
    "customAssets": {
      "type": "array"
    },
    "map": {
      "type": "object",
      "properties": {
        "textureId": {
          "type": "string"
        },
        "brushSize": {
          "type": "number"
        },
        "textureScale": {
          "type": "number"
        },
        "textureOpacity": {
          "type": "number"
        },
        "textureAngle": {
          "type": "number"
        },
        "snap": {
          "type": "boolean"
        },
        "grid": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "lighting": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ambientColor": {
          "type": "string"
        },
        "darkness": {
          "type": "number"
        },
        "lights": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "sounds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "src": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "radius": {
            "type": "number"
          },
          "volume": {
            "type": "number"
          },
          "loop": {
            "type": "boolean"
          },
          "spatial": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "trigger": {
            "enum": [
              "click",
              "enter",
              "ambient"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
