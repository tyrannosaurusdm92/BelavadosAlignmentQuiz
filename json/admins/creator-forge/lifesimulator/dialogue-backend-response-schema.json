{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lifesimulator://schemas/backend-response.schema.json",
  "title": "NPC Dialogue Backend Response",
  "type": "object",
  "required": ["mode", "responses"],
  "properties": {
    "mode": {"enum": ["single", "varied"]},
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "targetPlayerIds", "emotion", "reaction"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "targetPlayerIds": {"type": "array", "items": {"type": "string"}},
          "emotion": {"type": "string"},
          "reaction": {"type": "string"}
        }
      }
    },
    "memoryWrites": {"type": "array"},
    "statePatch": {"type": "object"},
    "decisionFactors": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
