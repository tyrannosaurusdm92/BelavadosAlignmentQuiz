{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lifesimulator://schemas/npc.schema.json",
  "title": "LifeSimulator NPC",
  "type": "object",
  "required": ["npcId", "name", "public", "private", "dialogue", "state", "provenance"],
  "properties": {
    "npcId": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "pronouns": {"type": "object", "required": ["subject", "object", "possessive", "reflexive"]},
    "genderIdentity": {"type": "string"},
    "species": {"type": "string"},
    "lineage": {"type": "string"},
    "culture": {"type": "string"},
    "profession": {"type": "string"},
    "public": {"type": "object"},
    "private": {"type": "object"},
    "factionIds": {"type": "array", "items": {"type": "string"}},
    "questIds": {"type": "array", "items": {"type": "string"}},
    "traits": {"type": "array", "items": {"type": "string"}},
    "dialogue": {
      "type": "object",
      "properties": {"responseMode": {"enum": ["adaptive", "single", "varied"]}}
    },
    "state": {"type": "object"},
    "token": {"type": "object"},
    "visibility": {"enum": ["public", "private", "secret", "protected"]},
    "protected": {"type": "boolean"},
    "extensions": {"type": "object"},
    "provenance": {"type": "object"}
  },
  "additionalProperties": true
}
