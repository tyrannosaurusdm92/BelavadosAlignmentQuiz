{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lifesimulator://schemas/quest.schema.json",
  "title": "LifeSimulator Quest",
  "type": "object",
  "required": ["questId", "title", "status", "stages", "objectives", "provenance"],
  "properties": {
    "questId": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "status": {"type": "string"},
    "giverNpcIds": {"type": "array", "items": {"type": "string"}},
    "factionIds": {"type": "array", "items": {"type": "string"}},
    "objectives": {"type": "array"},
    "hiddenObjectives": {"type": "array"},
    "stages": {
      "type": "array",
      "items": {"type": "object", "required": ["stageId", "description"]}
    },
    "currentStageId": {"type": ["string", "number"]},
    "triggers": {"type": "array"},
    "rewards": {"type": "array"},
    "consequences": {"type": "array"},
    "knowledgeRules": {"type": "array"},
    "visibility": {"enum": ["public", "private", "secret", "protected"]},
    "protected": {"type": "boolean"},
    "provenance": {"type": "object"}
  },
  "additionalProperties": true
}
