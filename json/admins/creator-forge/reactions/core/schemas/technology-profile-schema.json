{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LifeSimulator Technology Profile",
  "type": "object",
  "required": [
    "id",
    "label",
    "order",
    "capabilities",
    "infrastructure",
    "modes"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    },
    "capabilities": {
      "type": "array"
    },
    "infrastructure": {
      "type": "array"
    },
    "modes": {
      "type": "array"
    }
  }
}