{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "D&D 5e / 2024 (5.5e) XP Progression and Hybrid XP Calculator",
  "version": "1.0.0",
  "system": {
    "games": [
      "D&D 5e (2014)",
      "D&D 2024 / 5.5e"
    ],
    "minimumLevel": 1,
    "maximumLevel": 20,
    "maximumLevelThresholdXP": 355000,
    "advancementMethod": "cumulative experience points",
    "notes": [
      "A character reaches a level when total XP equals or exceeds that level's cumulative XP threshold.",
      "XP from hostiles, quests, and milestones is added to the same cumulative XP total.",
      "Milestones in this configuration award XP rather than automatically granting a level.",
      "At level 20, xpRequiredToAdvance is null because level 20 is the normal maximum character level."
    ]
  },
  "xpSources": [
    {
      "id": "hostile",
      "label": "Defeating or overcoming hostiles",
      "description": "XP awarded for combat, defeating enemies, bypassing enemies, or otherwise resolving hostile encounters."
    },
    {
      "id": "quest",
      "label": "Quest completion",
      "description": "XP awarded for completing quest objectives, discoveries, negotiations, rescues, investigations, or other noncombat accomplishments."
    },
    {
      "id": "milestone",
      "label": "Milestone achievement",
      "description": "DM-assigned XP for major story beats, chapter conclusions, important discoveries, faction changes, or campaign-defining accomplishments."
    },
    {
      "id": "other",
      "label": "Other XP",
      "description": "Any additional DM-approved XP award."
    }
  ],
  "levelProgression": [
    {
