  "calculator": {
    "inputTemplate": {
      "characterName": "",
      "startingXP": 0,
      "awards": [
        {
          "source": "hostile",
          "label": "",
          "xp": 0
        },
        {
          "source": "quest",
          "label": "",
          "xp": 0
        },
        {
          "source": "milestone",
          "label": "",
          "xp": 0
        }
      ]
    },
    "rules": {
      "earnedXP": "SUM(awards[*].xp)",
      "totalXP": "startingXP + earnedXP",
      "currentLevel": "Highest levelProgression.level where cumulativeXPRequired <= totalXP",
      "currentLevelThresholdXP": "levelProgression[currentLevel].cumulativeXPRequired",
      "nextLevel": "currentLevel + 1, unless currentLevel is 20",
      "nextLevelThresholdXP": "levelProgression[nextLevel].cumulativeXPRequired, or null at level 20",
      "xpIntoCurrentLevel": "totalXP - currentLevelThresholdXP",
      "xpNeededForNextLevel": "MAX(0, nextLevelThresholdXP - totalXP), or 0 at level 20",
      "currentLevelSpanXP": "nextLevelThresholdXP - currentLevelThresholdXP, or 0 at level 20",
      "progressPercent": "ROUND((xpIntoCurrentLevel / currentLevelSpanXP) * 100, 2), or 100 at level 20",
      "levelsGained": "currentLevel calculated after awards minus level calculated from startingXP"
    },
    "validation": {
      "startingXPMinimum": 0,
      "awardXPMinimum": 0,
      "allowedSources": [
        "hostile",
        "quest",
        "milestone",
        "other"
      ],
      "rounding": "XP awards and totals should be whole numbers."
    },
    "example": {
      "input": {
        "characterName": "Example Adventurer",
        "startingXP": 23000,
        "awards": [
          {
            "source": "hostile",
            "label": "Overcame hostile encounter",
            "xp": 3500
          },
          {
            "source": "quest",
            "label": "Completed a major quest",
            "xp": 5000
          },
          {
            "source": "milestone",
            "label": "Reached the ruined citadel",
            "xp": 4000
          }
        ]
      },
      "output": {
        "earnedXP": 12500,
        "totalXP": 35500,
        "startingLevel": 7,
        "currentLevel": 8,
        "levelsGained": 1,
        "currentLevelThresholdXP": 34000,
        "nextLevel": 9,
        "nextLevelThresholdXP": 48000,
        "xpIntoCurrentLevel": 1500,
        "xpNeededForNextLevel": 12500,
        "currentLevelSpanXP": 14000,
        "progressPercent": 10.71
      }
    }
