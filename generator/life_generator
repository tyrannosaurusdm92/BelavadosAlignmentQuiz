<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Belavadös Life Generator</title>
<link rel="stylesheet" href="css/life_generator.css" />
</head>
<body>
<header>
  <h1>Belavadös Life Generator</h1>
  <p class="subtitle">All-in-one settlement, province, and world generator for living locations, NPCs, relationships, schedules, travel, map pins, GeoJSON shells, imports, and export packages.</p>
  <div class="top-actions">
    <button id="generateBtn" class="gold">Generate / Refresh Current Scope</button>
    <button id="exportZipBtn" class="secondary">Export ZIP Package</button>
    <button id="saveBtn" class="secondary">Save Browser State</button>
    <button id="clearStateBtn" class="warning">Clear Browser State</button>
  </div>
</header>
<main class="layout">
  <aside class="sidebar card">
    <h2>Controls + Imports</h2>
    <div class="panel form-grid">
      <section>
        <label for="fileInput">Import JSON, GeoJSON, HTML, DOCX, PDF, or map image</label>
        <div id="dropzone" class="dropzone">Drop files here or choose files below. Parsed text and JSON will be scanned into the fill boxes.</div>
        <input id="fileInput" type="file" multiple accept=".json,.geojson,.html,.htm,.docx,.pdf,image/*" />
        <div id="fileList" class="file-list"></div>
      </section>
      <section>
        <h3>Generation Scope</h3>
        <div class="row">
          <div><label for="scopeMode">Scope</label><select id="scopeMode"><option value="settlement">One settlement</option><option value="province">Whole province</option><option value="world">Whole world</option></select></div>
          <div><label for="generationMode">Mode</label><select id="generationMode"><option value="generateSettlement">Generate Settlement</option><option value="generateCategory">Generate Category</option><option value="singleLocation">Generate Single Location</option><option value="missingOnly">Generate Missing Locations</option><option value="expandSettlement">Expand Existing Settlement</option></select></div>
        </div>
        <div class="row">
          <div id="provinceSelectWrap"><label for="provinceSelect">Province</label><select id="provinceSelect"></select></div>
          <div id="settlementSelectWrap"><label for="settlementSelect">Settlement</label><select id="settlementSelect"></select></div>
        </div>
        <div class="row">
          <div><label for="settlementType">Settlement Type</label><select id="settlementType"><option>Capital City</option><option>City</option><option>Town</option><option>Village</option></select></div>
          <div><label for="biomeSelect">Biome</label><select id="biomeSelect"></select></div>
        </div>
        <div class="row">
          <div><label for="locationCount">Locations</label><input id="locationCount" type="number" min="1" max="5000" value="60" /></div>
          <div><label for="npcCount">Named NPCs</label><input id="npcCount" type="number" min="1" max="15000" value="160" /></div>
        </div>
        <div class="row">
          <div><label for="populationInput">Population</label><input id="populationInput" type="number" min="1" value="1600" /></div>
          <div><label for="areaInput">Square mi / km²</label><input id="areaInput" type="text" placeholder="e.g. 18 sq mi" /></div>
        </div>
        <div class="row">
          <div><label for="timezoneInput">Time Zone</label><input id="timezoneInput" type="text" placeholder="UTC-4" /></div>
          <div><label for="dangerLevel">Danger Level</label><select id="dangerLevel"><option>Low</option><option selected>Moderate</option><option>High</option><option>Severe</option><option>Hidden / Political</option></select></div>
        </div>
        <label for="governmentType">Government Type</label><input id="governmentType" type="text" placeholder="Participatory Democracy, Consensus, Noocracy..." />
        <label for="alignmentPreference">Visitor Alignment Preference</label><select id="alignmentPreference"></select>
        <label for="primaryDeities">Primary Deities</label><input id="primaryDeities" type="text" placeholder="Nebyrr, Sigrananna, Horundar..." />
        <label for="settlementTags">Settlement Tags</label><textarea id="settlementTags" placeholder="guild-heavy, coastal, rail hub, shrine city, dangerous docks..."></textarea>
      </section>
      <section>
        <h3>Race + Alignment Dropdowns</h3>
        <div class="row">
          <div><label for="raceMode">Race Mode</label><select id="raceMode"><option value="weighted">Belavadös weighted mix</option><option value="category">Selected category</option><option value="race">Selected race</option><option value="allInCategory">Generate all races in category</option><option value="cache">Cached race pool</option></select></div>
          <div><label for="raceCategory">Race Category</label><select id="raceCategory"></select></div>
        </div>
        <label for="racePick">Specific Race / Bloodline</label><select id="racePick"></select>
        <div class="btns">
          <button id="btnAddRaceCache" class="secondary" type="button">Add Selected Race To Cache</button>
          <button id="btnAddCategoryCache" class="secondary" type="button">Add Category To Cache</button>
          <button id="btnClearRaceCache" class="warning" type="button">Clear Race Cache</button>
        </div>
        <div id="raceCacheList" class="race-cache-list notice">No race cache yet. Add races here to build a reusable world-generation pool.</div>
        <div class="btns">
          <button id="btnAllCategory" class="secondary" type="button">Generate All Races In Category</button>
          <button id="btnSelectedRace" class="secondary" type="button">Generate Selected Race</button>
          <button id="btnMixedPopulation" class="secondary" type="button">Generate Mixed Population</button>
        </div>
      </section>
      <section>
        <h3>Living-World Rules</h3>
        <div class="checkbox"><input id="includeFivePercent" type="checkbox" checked /><span>Apply 5% rare variation to locations, NPCs, relationships, and schedules.</span></div>
        <div class="checkbox"><input id="includeTravelers" type="checkbox" checked /><span>Create travelers, commuters, vacations, work trips, and transit-worker routes for province/world scopes.</span></div>
        <div class="checkbox"><input id="includeGeojsonPins" type="checkbox" checked /><span>Auto-fill blank GeoJSON/SVG pin shells with 2px-style map pin data.</span></div>
        <div class="checkbox"><input id="preserveExisting" type="checkbox" checked /><span>Preserve existing generated records unless a selected record is rerolled or edited.</span></div>
      </section>
      <section>
        <h3>Exports</h3>
        <div class="btns">
          <button id="exportJsonBtn" class="secondary" type="button">Export JSON</button>
          <button id="exportGeoJsonBtn" class="secondary" type="button">Export GeoJSON</button>
          <button id="exportHtmlBtn" class="secondary" type="button">Export HTML</button>
          <button id="exportDocxBtn" class="secondary" type="button">Export DOCX</button>
        </div>
      </section>
      <div id="controlMeta" class="notice">Ready. Generate a settlement, province, or world, or import existing files to restore data.</div>
    </div>
  </aside>
  <section class="card">
    <h2>Generated World Data</h2>
    <nav class="tabs">
      <button class="tab active" data-tab="overview">Overview</button>
      <button class="tab" data-tab="locations">Locations</button>
      <button class="tab" data-tab="npcs">NPCs</button>
      <button class="tab" data-tab="relationships">Relationships</button>
      <button class="tab" data-tab="travel">Travel</button>
      <button class="tab" data-tab="map">Map / GeoJSON</button>
      <button class="tab" data-tab="imports">Imports</button>
      <button class="tab" data-tab="json">JSON</button>
    </nav>
    <div class="panel">
      <div class="toolbar">
        <input id="filterInput" class="search" type="text" placeholder="Filter visible generated data..." />
        <div id="resultCount" class="mini">Nothing generated yet.</div>
      </div>
      <div id="overview" class="tabpane"></div>
      <div id="locations" class="tabpane hidden"></div>
      <div id="npcs" class="tabpane hidden"></div>
      <div id="relationships" class="tabpane hidden"></div>
      <div id="travel" class="tabpane hidden"></div>
      <div id="map" class="tabpane hidden"></div>
      <div id="imports" class="tabpane hidden"></div>
      <pre id="json" class="tabpane hidden item codebox"></pre>
    </div>
  </section>
</main>
<div id="editorBackdrop" class="modal-backdrop">
  <div class="modal">
    <header><h2 id="editorTitle">Edit Record</h2><button id="editorClose" class="secondary small" type="button">Close</button></header>
    <div class="panel form-grid">
      <div class="hint">Edit the JSON directly. Saving only changes the selected record and never rerolls unrelated records.</div>
      <textarea id="editorText"></textarea>
      <div class="btns"><button id="editorSave" class="gold" type="button">Save Record</button><button id="editorReroll" class="secondary" type="button">Reroll Selected Record</button></div>
    </div>
  </div>
</div>
<div id="status" class="status"></div>
<p class="footer-note">Generated NPCs and locations stay in memory and browser storage until you clear, edit, import over, or reroll them. ZIP exports include HTML, JSON, GeoJSON, DOCX, schedule, relationship, travel, CSS, and JavaScript files.</p>
<script src="js/vendor/jszip.min.js"></script>
<script src="js/data/generator_rules.js"></script>
<script src="js/data/belavados_race_dropdown_data.js"></script>
<script src="js/data/settlement_assignments.js"></script>
<script src="js/data/belavados_time_model.js"></script>
<script src="js/data/belavados_location_catalog.js"></script>
<script src="js/utils.js"></script>
<script src="js/importers.js"></script>
<script src="js/generator_core.js"></script>
<script src="js/renderers.js"></script>
<script src="js/exporters.js"></script>
<script src="js/life_generator_app.js"></script>
</body>
</html>
