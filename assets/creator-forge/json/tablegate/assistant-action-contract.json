{
  "schema": "tablegate.assistant-action-contract.v1",
  "reviewRequired": true,
  "allowedActions": {
    "npc.generate": {
      "required": [
        "count"
      ],
      "optional": [
        "seed",
        "profession",
        "locationId",
        "genderIdentityId",
        "systemId",
        "editionId",
        "raceId"
      ]
    },
    "location.generate": {
      "required": [
        "count"
      ],
      "optional": [
        "name",
        "type",
        "category",
        "parentLocationId",
        "mapLevel",
        "services",
        "biomeId"
      ]
    },
    "settlement.generate": {
      "optional": [
        "name",
        "size",
        "seed",
        "parentLocationId",
        "population",
        "npcCount"
      ]
    },
    "transit.type.add": {
      "required": [
        "name",
        "color",
        "travelModel"
      ]
    },
    "transit.stop.add": {
      "required": [
        "name"
      ]
    },
    "transit.route.add": {
      "required": [
        "name",
        "transitTypeId",
        "stopIds"
      ]
    },
    "transit.service.add": {
      "required": [
        "routeId"
      ]
    },
    "transit.trip.plan": {
      "required": [
        "originStopId",
        "destinationStopId",
        "departMinute"
      ]
    },
    "project.note.add": {
      "required": [
        "text"
      ]
    }
  }
}