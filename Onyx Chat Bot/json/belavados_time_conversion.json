  "cleanMath": [
    {
      "item": "Belavadös solar year",
      "simplifiedValue": "330.15 Belavadös solar days"
    },
    {
      "item": "Belavadös civil calendar",
      "simplifiedValue": "11 months x 30 dates = 330 named civil dates"
    },
    {
      "item": "Earth year used for play",
      "simplifiedValue": "365 days, or 366 days in leap years"
    },
    {
      "item": "Non-leap year pace",
      "simplifiedValue": "1 Earth day = 330.15 / 365 = 0.9045205 Belavadös solar days"
    },
    {
      "item": "Leap year pace",
      "simplifiedValue": "1 Earth day = 330.15 / 366 = 0.9020492 Belavadös solar days"
    },
    {
      "item": "Non-leap Belavadös civil date length",
      "simplifiedValue": "365 / 330 = 1.10606 Earth days per named civil date"
    },
    {
      "item": "Month length on Earth calendar",
      "simplifiedValue": "365 / 11 = 33.18 Earth days per Belavadös month in a non-leap year"
    }
  ],
  "conversion": {
    "purpose": "Convert live Earth date/time into Belavadös civil calendar, Belavadös clock, and astronomical solar progress.",
    "inputs": {
      "earthDateTime": "Earth datetime with timezone or UTC offset",
      "earthDayOfYear": "1-based day of year",
      "fractionOfEarthDay": "0.0 through <1.0, derived from hour/minute/second/millisecond",
      "daysInEarthYear": "365, or 366 in a leap year"
    },
    "steps": [
      "daysInEarthYear = 365, or 366 in a leap year.",
      "earthProgress = (Earth day-of-year - 1 + fractionOfEarthDay) / daysInEarthYear.",
      "belSolarDayProgress = earthProgress x 330.15. Use this for sky, moon, season, and astronomy math.",
      "belCivilDateProgress = earthProgress x 330. Use this for the named calendar date.",
      "monthIndex = floor(belCivilDateProgress / 30), from 0 to 10.",
      "dayOfMonth = floor(belCivilDateProgress % 30) + 1.",
      "Belavadös clock time may use the fractional part of belSolarDayProgress x 24."
    ],
    "formulas": {
      "daysInEarthYear": "isLeapYear(earthYear) ? 366 : 365",
      "fractionOfEarthDay": "(hour + minute / 60 + second / 3600 + millisecond / 3600000) / 24",
      "earthProgress": "(earthDayOfYear - 1 + fractionOfEarthDay) / daysInEarthYear",
      "belSolarDayProgress": "earthProgress * 330.15",
      "belCivilDateProgress": "earthProgress * 330",
      "monthIndex": "floor(belCivilDateProgress / 30)",
      "monthNumber": "monthIndex + 1",
      "dayOfMonth": "floor(belCivilDateProgress % 30) + 1",
      "belavadosClockHourFloat": "(belSolarDayProgress % 1) * 24",
      "belavadosClockHour": "floor(belavadosClockHourFloat)",
      "belavadosClockMinute": "floor((belavadosClockHourFloat % 1) * 60)",
      "belavadosClockSecond": "floor((((belavadosClockHourFloat % 1) * 60) % 1) * 60)"
    },
    "importantDistinction": "Important distinction: the Night Sky uses the astronomical year of 330.15 Belavadös days. The civil calendar still has 330 named dates. The extra 0.15 is distributed through the year as a tiny solar/clock correction, not stored as a bonus day at the end."
  },
